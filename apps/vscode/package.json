{
  "name": "@deepseek-ai/dsh-vscode",
  "displayName": "DeepSeek Harness",
  "description": "DeepSeek Harness in VSCode: a slim session sidebar plus the full web chat surface in an editor panel, driven by a local web kernel.",
  "version": "0.1.0",
  "publisher": "deepseek-ai",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.vsix",
    "media"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/vscode"
  },
  "categories": ["Machine Learning", "Chat", "Other"],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-sidebar",
          "title": "DeepSeek Harness",
          "icon": "media/logo-whale-pink.svg"
        }
      ]
    },
    "views": {
      "dsh-sidebar": [
        {
          "type": "webview",
          "id": "dsh.sidebar",
          "name": "Sessions",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openChat",
        "title": "Open DeepSeek Harness",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dsh.closeChat",
        "title": "Close DeepSeek Harness"
      },
      {
        "command": "dsh.newSession",
        "title": "New DeepSeek Harness Session",
        "icon": "$(add)"
      },
      {
        "command": "dsh.showLogs",
        "title": "Show DeepSeek Harness Logs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.newSession",
          "when": "view == dsh.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "dsh.openChat",
          "when": "view == dsh.sidebar",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.closeChat",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "dsh-vscode.uiLocale": {
          "type": "string",
          "enum": ["auto", "en", "zh-cn"],
          "enumItemLabels": ["Auto (follow VSCode)", "English", "简体中文"],
          "default": "auto",
          "description": "Sidebar and panel UI language. auto follows VSCode's display language; en English; zh-cn 简体中文。界面语言：auto 跟随 VSCode 显示语言，en 英文，zh-cn 简体中文。"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack:vsix": "node scripts/build.mjs && node scripts/pack-vsix.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-web-frontend": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.0"
  }
}
